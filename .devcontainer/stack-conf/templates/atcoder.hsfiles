{- End of Bonsai -}
{- Kluges -}

{- End of Kluges -}

{-# START_FILE activate #-}
#!/bin/bash
chmod u+x building checking executing ghcing initializing resetting setting submitting

ghcup set hls 2.14.0.0
ghcup set ghc 9.8.4
        
cp stack.yaml.atcoder stack.yaml

cp $HOME/.config/atcoder-cli-nodejs/haskell/Main.hs app/Main.hs

stack build

acc config default-task-choice all

{-# START_FILE initializing #-}
#!/bin/bash

acc new {{name}}
mv {{name}}/contest.acc.json ./

jq -r '.tasks[].directory.path' ./contest.acc.json | while read tid; do
  mv {{name}}/${tid} app/
  ./setting ${tid}
done

rmdir {{name}}
cp contest.acc.json app/
ln -s ./app ./{{name}}

./resetting a

{-# START_FILE setting #-}
#!/bin/bash

add-entry $1

echo "export CURRENT_STACK_EXE_ENTRY=$1" > .curname

source .curname
./building

if type "gen-hie" > /dev/null 2>&1; then
    gen-hie > hie.yaml
else
    stack install implicit-hie
    gen-hie > hie.yaml
fi

{-# START_FILE resetting #-}
#!/bin/bash

echo "export CURRENT_STACK_EXE_ENTRY=$1" > .curname

{-# START_FILE ghcing #-}
#!/bin/bash

source .curname
stack exec -- ghci app/$CURRENT_STACK_EXE_ENTRY/Main.hs

{-# START_FILE checking #-}
#!/bin/bash

source .curname

./building && oj t -c ./executing -d app/$CURRENT_STACK_EXE_ENTRY/test

{-# START_FILE building #-}
#!/bin/bash

source .curname
stack build {{name}}:exe:$CURRENT_STACK_EXE_ENTRY

{-# START_FILE executing #-}
#!/bin/bash

source .curname
./building && stack exec -- $CURRENT_STACK_EXE_ENTRY

{-# START_FILE submitting #-}
#!/bin/bash

source .curname
./checking && cd {{name}}/$CURRENT_STACK_EXE_ENTRY && acc s -s -- -y
